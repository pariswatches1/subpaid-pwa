// SubPaid Database Schema
// PostgreSQL database on Neon

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  company       String?
  phone         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  clients       Client[]
  jobs          Job[]
  estimates     Estimate[]
  invoices      Invoice[]
  leads         Lead[]
  leadSources   LeadSource[]
  timeEntries   TimeEntry[]
  crewMembers   CrewMember[]
}

// ============================================
// CLIENTS
// ============================================

model Client {
  id         String    @id @default(cuid())
  userId     String
  name       String
  email      String
  phone      String?
  company    String?
  address    String?
  payScore   Int?      @default(50)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]

  @@index([userId])
  @@index([email])
}

// ============================================
// JOBS
// ============================================

model Job {
  id           String    @id @default(cuid())
  userId       String
  clientId     String
  leadSourceId String?
  title        String
  description  String?
  status       String    @default("active") // active, completed, on_hold, cancelled
  address      String?
  budget       Decimal?  @db.Decimal(10, 2)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id])
  invoices     Invoice[]
  estimates    Estimate[]
  timeEntries  TimeEntry[]

  @@index([userId])
  @@index([clientId])
  @@index([leadSourceId])
}

// ============================================
// ESTIMATES
// ============================================

model Estimate {
  id              String    @id @default(cuid())
  estimateNumber  String
  userId          String
  clientId        String
  jobId           String?
  leadSourceId    String?
  title           String
  status          String    @default("draft") // draft, sent, accepted, rejected, expired
  lineItems       Json      @default("[]")
  subtotal        Decimal   @db.Decimal(10, 2) @default(0)
  markup          Decimal   @db.Decimal(10, 2) @default(0)
  tax             Decimal   @db.Decimal(10, 2) @default(0)
  total           Decimal   @db.Decimal(10, 2) @default(0)
  notes           String?
  validUntil      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  convertedToInvoiceId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job             Job?       @relation(fields: [jobId], references: [id])
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([estimateNumber])
}

// ============================================
// INVOICES
// ============================================

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String
  userId          String
  clientId        String
  jobId           String?
  leadSourceId    String?
  status          String    @default("draft") // draft, sent, viewed, paid, overdue, cancelled
  lineItems       Json      @default("[]")
  subtotal        Decimal   @db.Decimal(10, 2) @default(0)
  tax             Decimal   @db.Decimal(10, 2) @default(0)
  total           Decimal   @db.Decimal(10, 2) @default(0)
  notes           String?
  dueDate         DateTime
  sentAt          DateTime?
  viewedAt        DateTime?
  paidAt          DateTime?
  autopilotEnabled Boolean  @default(false)
  remindersSent   Int       @default(0)
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job             Job?       @relation(fields: [jobId], references: [id])
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([invoiceNumber])
  @@index([status])
}

// ============================================
// LEADS - Automatic Leads Inbox
// ============================================

model Lead {
  id              String    @id @default(cuid())
  userId          String
  leadSourceId    String?

  // Source tracking
  sourceType      String    // email, call, form, bid, manual
  sourceName      String?   // "Thumbtack", "Angi", "Google Ads", etc.

  // Contact info
  name            String?
  email           String?
  phone           String?
  company         String?

  // Job details
  description     String?
  location        String?
  trade           String?
  estimatedValue  Decimal?  @db.Decimal(10, 2)

  // Raw data
  rawContent      String?
  rawSubject      String?

  // Status tracking
  status          String    @default("new") // new, contacted, quoted, won, lost, archived
  priority        String    @default("warm") // hot, warm, cold

  // Conversion tracking
  convertedToJobId      String?
  convertedToEstimateId String?
  convertedToInvoiceId  String?

  // Timestamps
  receivedAt      DateTime  @default(now())
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([leadSourceId])
  @@index([status])
  @@index([sourceType])
}

// ============================================
// LEAD SOURCES - ROI Tracking
// ============================================

model LeadSource {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  keywords            Json      @default("[]")
  generatedContent    String?
  pageUrl             String?
  trackingPhoneNumber String?

  // UTM Parameters
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?

  // Cost tracking
  monthlyAdSpend      Decimal?  @db.Decimal(10, 2)
  seoRetainerCost     Decimal?  @db.Decimal(10, 2)
  otherCosts          Decimal?  @db.Decimal(10, 2)
  costNotes           String?

  // Stats (denormalized for performance)
  jobsLinked          Int       @default(0)
  invoicesLinked      Int       @default(0)
  amountPaid          Decimal   @db.Decimal(10, 2) @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                Job[]
  estimates           Estimate[]
  invoices            Invoice[]
  leads               Lead[]
  timelineEvents      LeadTimelineEvent[]

  @@index([userId])
}

// ============================================
// LEAD TIMELINE EVENTS
// ============================================

model LeadTimelineEvent {
  id            String    @id @default(cuid())
  leadSourceId  String
  userId        String
  eventType     String    // call, form_submit, job_created, estimate_sent, invoice_sent, payment_received, etc.
  entityId      String?
  description   String
  amount        Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())

  // Relations
  leadSource    LeadSource @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)

  @@index([leadSourceId])
  @@index([eventType])
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  jobId       String?
  description String?
  hours       Decimal   @db.Decimal(5, 2)
  rate        Decimal?  @db.Decimal(10, 2)
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?      @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
}

// ============================================
// CREW MEMBERS
// ============================================

model CrewMember {
  id          String    @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  role        String?
  hourlyRate  Decimal?  @db.Decimal(10, 2)
  status      String    @default("active") // active, inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
