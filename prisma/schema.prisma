// SubPaid Database Schema
// PostgreSQL database on Neon

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  company       String?
  phone         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  clients       Client[]
  jobs          Job[]
  estimates     Estimate[]
  invoices      Invoice[]
  leads         Lead[]
  leadSources   LeadSource[]
  timeEntries   TimeEntry[]
  crewMembers   CrewMember[]

  // Premium Features
  lienProjects      LienProject[]
  gcRatings         GCRating[]
  profitGuardBids   ProfitGuardBid[]
  aiaApplications   AIAApplication[]
  snapInvoices      SnapInvoice[]
  samAgentCalls     SAMAgentCall[]
  callRecords       CallTrackingRecord[]
  prequalDocs       PrequalDocument[]
}

// ============================================
// CLIENTS
// ============================================

model Client {
  id         String    @id @default(cuid())
  userId     String
  name       String
  email      String
  phone      String?
  company    String?
  address    String?
  payScore   Int?      @default(50)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]

  @@index([userId])
  @@index([email])
}

// ============================================
// JOBS
// ============================================

model Job {
  id           String    @id @default(cuid())
  userId       String
  clientId     String
  leadSourceId String?
  title        String
  description  String?
  status       String    @default("active") // active, completed, on_hold, cancelled
  address      String?
  budget       Decimal?  @db.Decimal(10, 2)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id])
  invoices     Invoice[]
  estimates    Estimate[]
  timeEntries  TimeEntry[]

  @@index([userId])
  @@index([clientId])
  @@index([leadSourceId])
}

// ============================================
// ESTIMATES
// ============================================

model Estimate {
  id              String    @id @default(cuid())
  estimateNumber  String
  userId          String
  clientId        String
  jobId           String?
  leadSourceId    String?
  title           String
  status          String    @default("draft") // draft, sent, accepted, rejected, expired
  lineItems       Json      @default("[]")
  subtotal        Decimal   @db.Decimal(10, 2) @default(0)
  markup          Decimal   @db.Decimal(10, 2) @default(0)
  tax             Decimal   @db.Decimal(10, 2) @default(0)
  total           Decimal   @db.Decimal(10, 2) @default(0)
  notes           String?
  validUntil      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  convertedToInvoiceId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job             Job?       @relation(fields: [jobId], references: [id])
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([estimateNumber])
}

// ============================================
// INVOICES
// ============================================

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String
  userId          String
  clientId        String
  jobId           String?
  leadSourceId    String?
  status          String    @default("draft") // draft, sent, viewed, paid, overdue, cancelled
  lineItems       Json      @default("[]")
  subtotal        Decimal   @db.Decimal(10, 2) @default(0)
  tax             Decimal   @db.Decimal(10, 2) @default(0)
  total           Decimal   @db.Decimal(10, 2) @default(0)
  notes           String?
  dueDate         DateTime
  sentAt          DateTime?
  viewedAt        DateTime?
  paidAt          DateTime?
  autopilotEnabled Boolean  @default(false)
  remindersSent   Int       @default(0)
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job             Job?       @relation(fields: [jobId], references: [id])
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([invoiceNumber])
  @@index([status])
}

// ============================================
// LEADS - Automatic Leads Inbox
// ============================================

model Lead {
  id              String    @id @default(cuid())
  userId          String
  leadSourceId    String?

  // Source tracking
  sourceType      String    // email, call, form, bid, manual
  sourceName      String?   // "Thumbtack", "Angi", "Google Ads", etc.

  // Contact info
  name            String?
  email           String?
  phone           String?
  company         String?

  // Job details
  description     String?
  location        String?
  trade           String?
  estimatedValue  Decimal?  @db.Decimal(10, 2)

  // Raw data
  rawContent      String?
  rawSubject      String?

  // Status tracking
  status          String    @default("new") // new, contacted, quoted, won, lost, archived
  priority        String    @default("warm") // hot, warm, cold

  // Conversion tracking
  convertedToJobId      String?
  convertedToEstimateId String?
  convertedToInvoiceId  String?

  // Timestamps
  receivedAt      DateTime  @default(now())
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadSource      LeadSource? @relation(fields: [leadSourceId], references: [id])

  @@index([userId])
  @@index([leadSourceId])
  @@index([status])
  @@index([sourceType])
}

// ============================================
// LEAD SOURCES - ROI Tracking
// ============================================

model LeadSource {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  keywords            Json      @default("[]")
  generatedContent    String?
  pageUrl             String?
  trackingPhoneNumber String?

  // UTM Parameters
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?

  // Cost tracking
  monthlyAdSpend      Decimal?  @db.Decimal(10, 2)
  seoRetainerCost     Decimal?  @db.Decimal(10, 2)
  otherCosts          Decimal?  @db.Decimal(10, 2)
  costNotes           String?

  // Stats (denormalized for performance)
  jobsLinked          Int       @default(0)
  invoicesLinked      Int       @default(0)
  amountPaid          Decimal   @db.Decimal(10, 2) @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                Job[]
  estimates           Estimate[]
  invoices            Invoice[]
  leads               Lead[]
  timelineEvents      LeadTimelineEvent[]

  @@index([userId])
}

// ============================================
// LEAD TIMELINE EVENTS
// ============================================

model LeadTimelineEvent {
  id            String    @id @default(cuid())
  leadSourceId  String
  userId        String
  eventType     String    // call, form_submit, job_created, estimate_sent, invoice_sent, payment_received, etc.
  entityId      String?
  description   String
  amount        Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())

  // Relations
  leadSource    LeadSource @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)

  @@index([leadSourceId])
  @@index([eventType])
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  jobId       String?
  description String?
  hours       Decimal   @db.Decimal(5, 2)
  rate        Decimal?  @db.Decimal(10, 2)
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?      @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
}

// ============================================
// CREW MEMBERS
// ============================================

model CrewMember {
  id          String    @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  role        String?
  hourlyRate  Decimal?  @db.Decimal(10, 2)
  status      String    @default("active") // active, inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// LIENGUARD - Lien Rights Protection
// ============================================

model LienProject {
  id                  String    @id @default(cuid())
  userId              String
  projectName         String
  gcName              String
  address             String
  state               String
  startDate           DateTime
  lastWorkDate        DateTime?
  contractAmount      Decimal   @db.Decimal(10, 2)
  amountOwed          Decimal   @db.Decimal(10, 2)
  preNoticeRequired   Boolean   @default(true)
  preNoticeDeadline   DateTime?
  preNoticeSent       Boolean   @default(false)
  preNoticeSentDate   DateTime?
  lienDeadline        DateTime
  lienFiled           Boolean   @default(false)
  status              String    @default("protected")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           LienDocument[]

  @@index([userId])
  @@index([status])
}

model LienDocument {
  id              String      @id @default(cuid())
  lienProjectId   String
  type            String
  filename        String
  content         String?     @db.Text
  generatedAt     DateTime    @default(now())
  sentAt          DateTime?

  lienProject     LienProject @relation(fields: [lienProjectId], references: [id], onDelete: Cascade)

  @@index([lienProjectId])
}

// ============================================
// PAYSCORE / GCSCORE - Contractor Ratings
// ============================================

model GCRating {
  id                 String    @id @default(cuid())
  userId             String
  gcName             String
  projectName        String?
  paymentScore       Int       @default(50)
  communicationScore Int       @default(50)
  fairnessScore      Int       @default(50)
  overallScore       Int       @default(50)
  review             String?
  wouldWorkAgain     Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gcName])
}

// ============================================
// PROFITGUARD - Bid Analysis
// ============================================

model ProfitGuardBid {
  id              String    @id @default(cuid())
  userId          String
  projectName     String
  clientName      String?
  bidAmount       Decimal   @db.Decimal(10, 2)
  materialCost    Decimal   @db.Decimal(10, 2) @default(0)
  laborCost       Decimal   @db.Decimal(10, 2) @default(0)
  overheadPercent Decimal   @db.Decimal(5, 2) @default(10)
  profitMargin    Decimal   @db.Decimal(5, 2) @default(0)
  status          String    @default("draft")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// AIA BILLING - G702/G703 Applications
// ============================================

model AIAApplication {
  id                  String    @id @default(cuid())
  userId              String
  applicationNumber   Int
  projectName         String
  contractSum         Decimal   @db.Decimal(12, 2)
  changeOrdersTotal   Decimal   @db.Decimal(12, 2) @default(0)
  completedToDate     Decimal   @db.Decimal(12, 2) @default(0)
  retainagePercent    Decimal   @db.Decimal(5, 2) @default(10)
  previousPayments    Decimal   @db.Decimal(12, 2) @default(0)
  currentDue          Decimal   @db.Decimal(12, 2) @default(0)
  periodFrom          DateTime?
  periodTo            DateTime?
  status              String    @default("draft")
  lineItems           Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// SNAP TO INVOICE - OCR Processing
// ============================================

model SnapInvoice {
  id                   String    @id @default(cuid())
  userId               String
  originalImage        String?
  extractedData        Json      @default("{}")
  vendorName           String?
  invoiceNumber        String?
  invoiceDate          DateTime?
  totalAmount          Decimal?  @db.Decimal(10, 2)
  lineItems            Json      @default("[]")
  status               String    @default("pending")
  convertedToInvoiceId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// SAM AGENT / AUTOPILOT - AI Call Handling
// ============================================

model SAMAgentCall {
  id              String    @id @default(cuid())
  userId          String
  callId          String?   @unique
  callerPhone     String?
  callerName      String?
  duration        Int       @default(0)
  transcript      String?   @db.Text
  summary         String?
  intent          String?
  leadCreated     Boolean   @default(false)
  leadId          String?
  status          String    @default("completed")
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// CALL TRACKING
// ============================================

model CallTrackingRecord {
  id              String    @id @default(cuid())
  userId          String
  leadSourceId    String?
  trackingNumber  String
  callerNumber    String?
  duration        Int       @default(0)
  recording       String?
  status          String    @default("completed")
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadSourceId])
}

// ============================================
// PREQUAL - Document Management
// ============================================

model PrequalDocument {
  id              String    @id @default(cuid())
  userId          String
  documentType    String
  name            String
  fileUrl         String?
  expirationDate  DateTime?
  status          String    @default("valid")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
}

// ============================================
// CONTRACTORS DIRECTORY
// ============================================

model Contractor {
  id              String    @id @default(cuid())
  businessName    String
  ownerName       String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  licenseNumber   String?
  licenseState    String?
  trades          Json      @default("[]")
  insuranceExpiry DateTime?
  rating          Decimal?  @db.Decimal(3, 2)
  reviewCount     Int       @default(0)
  verified        Boolean   @default(false)
  claimedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([state])
  @@index([licenseNumber])
  @@index([businessName])
}
